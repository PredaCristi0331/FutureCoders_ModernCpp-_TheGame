<Window x:Class="HangmanWpf.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About – Hangman" Height="260" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="🪢 Hangman WPF" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="{Binding StudentName, StringFormat='Student: {0}'}" FontSize="14" Margin="0,4"/>
        <TextBlock Text="{Binding GroupNumber, StringFormat='Group: {0}'}" FontSize="14" Margin="0,4"/>
        <TextBlock Text="{Binding Specialization, StringFormat='Specialization: {0}'}" FontSize="14" Margin="0,4"/>
        <TextBlock Text="{Binding AppVersion, StringFormat='Version: {0}'}" FontSize="12"
                   Foreground="#888" Margin="0,8,0,0"/>
        <Button Content="OK" Width="80" Margin="0,16,0,0" HorizontalAlignment="Center"
                Click="Ok_Click" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
</Window>
