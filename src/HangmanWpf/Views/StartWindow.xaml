<Window x:Class="HangmanWpf.Views.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HangmanWpf.Converters"
        Title="Hangman – Login" Height="520" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ImagePathToBitmapConverter x:Key="ImgConv"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="🪢 Hangman" FontSize="26" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#2c3e50"/>

        <!-- User list -->
        <GroupBox Grid.Row="1" Header="Select User" Margin="0,0,0,10">
            <ListBox ItemsSource="{Binding Users}"
                     SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <Image Width="40" Height="40" Margin="0,0,8,0"
                                   Source="{Binding ImagePath, Converter={StaticResource ImgConv}}"
                                   Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Selected user action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="▶ Play" Command="{Binding PlayCommand}"
                    Width="100" Margin="5" Style="{StaticResource PrimaryButton}"/>
            <Button Content="🗑 Delete User" Command="{Binding DeleteUserCommand}"
                    Width="120" Margin="5" Style="{StaticResource DangerButton}"/>
        </StackPanel>

        <!-- New user form -->
        <GroupBox Grid.Row="3" Header="Create New User">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5,5,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Avatar:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding NewUserImagePath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True" Margin="5,5,5,5"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Command="{Binding BrowseImageCommand}"
                        Padding="6,2"/>

                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Content="Create User" Command="{Binding CreateUserCommand}"
                        HorizontalAlignment="Right" Width="110" Margin="0,5,0,0"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
