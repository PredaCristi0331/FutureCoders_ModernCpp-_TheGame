<Window x:Class="HangmanWpf.Views.OpenGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Saved Game" Height="300" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a saved game to open:"
                   FontSize="14" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" x:Name="SavedGamesList"
                 DisplayMemberPath="DisplayName"
                 MouseDoubleClick="SavedGamesList_DoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Open" Width="80" Margin="0,0,8,0"
                    Click="Open_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
