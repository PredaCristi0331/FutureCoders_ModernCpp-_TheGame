<Window x:Class="HangmanWpf.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HangmanWpf.Converters"
        xmlns:vm="clr-namespace:HangmanWpf.ViewModels"
        Title="Hangman – Game" Height="680" Width="860"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:ImagePathToBitmapConverter x:Key="ImgConv"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewGameCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveGameCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenGameCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Game" Command="{Binding NewGameCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Game" Command="{Binding OpenGameCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save Game" Command="{Binding SaveGameCommand}" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="S_tatistics" Click="Statistics_Click"/>
                <Separator/>
                <MenuItem Header="C_ancel" Command="{Binding CancelCommand}"/>
            </MenuItem>
            <MenuItem Header="_Categories" ItemsSource="{Binding Categories}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding}"/>
                        <Setter Property="Command" Value="{Binding DataContext.SelectCategoryCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="CommandParameter" Value="{Binding}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main content -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: User info + hangman image -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <!-- User info -->
                <Border BorderBrush="#ccc" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <Image Width="80" Height="80" Margin="0,0,0,6"
                               Source="{Binding UserAvatarPath, Converter={StaticResource ImgConv}}"
                               Stretch="UniformToFill"/>
                        <TextBlock Text="{Binding User.Name}" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedCategory, StringFormat='Category: {0}'}"
                                   FontSize="11" HorizontalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding ConsecutiveWins, StringFormat='Level: {0}/3'}"
                                   FontSize="12" HorizontalAlignment="Center" Foreground="#2980b9" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Hangman image -->
                <Border BorderBrush="#ccc" BorderThickness="1" CornerRadius="6" Padding="4">
                    <Image Width="170" Height="200"
                           Source="{Binding HangmanImagePath, Converter={StaticResource ImgConv}}"
                           Stretch="Uniform"/>
                </Border>

                <!-- Mistakes -->
                <TextBlock Text="{Binding Mistakes, StringFormat='Mistakes: {0}/6'}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Right: game area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Timer -->
                <Border Grid.Row="0" Background="#ecf0f1" CornerRadius="4" Padding="6,3" Margin="0,0,0,8" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TimeRemaining, StringFormat='⏱ {0}s'}"
                               FontSize="16" FontWeight="Bold" Foreground="#e74c3c"/>
                </Border>

                <!-- Masked word -->
                <TextBlock Grid.Row="1" Text="{Binding MaskedWord}"
                           FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10,0,10"
                           FontFamily="Courier New" Foreground="#2c3e50"/>

                <!-- Status message -->
                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="#27ae60"/>

                <!-- Letter buttons -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Letters}" Margin="0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Letter}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Width="34" Height="34" Margin="2"
                                    FontWeight="Bold" FontSize="13"
                                    Command="{Binding DataContext.GuessLetterCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Letter}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bottom new-game hint -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="New Game (Ctrl+N)" Command="{Binding NewGameCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="4"/>
                    <Button Content="Save (Ctrl+S)" Command="{Binding SaveGameCommand}"
                            Margin="4"/>
                    <Button Content="Open (Ctrl+O)" Command="{Binding OpenGameCommand}"
                            Margin="4"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
